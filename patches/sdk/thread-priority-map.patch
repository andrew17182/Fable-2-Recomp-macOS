+      const int level = MapGuestPriorityLevel(params.initial_priority);
+      if (level != 0) {
+        sched_param sched{};
+        sched.sched_priority = MappedSchedPriority(level);
+        if (pthread_attr_setschedpolicy(&attr, SCHED_OTHER) != 0 ||
+            pthread_attr_setschedparam(&attr, &sched) != 0) {
