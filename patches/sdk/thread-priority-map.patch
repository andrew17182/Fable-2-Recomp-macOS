@@ -971,6 +1014,34 @@
 
   void set_priority(int new_priority) {
     WaitStarted();
+#if defined(__APPLE__)
+    if (ThreadPriorityMapEnabled()) {
+      const int level = MapGuestPriorityLevel(new_priority);
+      int policy = 0;
+      sched_param current{};
+      if (level == 0) {
+        // Normal: undo an earlier mapped change, otherwise leave the thread (and its QoS) alone.
+        if (pthread_getschedparam(thread_, &policy, &current) == 0 &&
+            current.sched_priority != MappedSchedPriority(0) && priority_mapped_) {
+          sched_param param{};
+          param.sched_priority = MappedSchedPriority(0);
+          pthread_setschedparam(thread_, SCHED_OTHER, &param);
+        }
+        priority_mapped_ = false;
+        return;
+      }
+      sched_param param{};
+      param.sched_priority = MappedSchedPriority(level);
+      const int result = pthread_setschedparam(thread_, SCHED_OTHER, &param);
+      if (result != 0) {
+        REXSYS_WARN("set_priority: pthread_setschedparam(SCHED_OTHER, {}) failed ({})",
+                    param.sched_priority, result);
+      } else {
+        priority_mapped_ = true;
+      }
+      return;
+    }
+#endif
     sched_param param{};
     param.sched_priority = new_priority;
     int result = pthread_setschedparam(thread_, SCHED_FIFO, &param);
@@ -1171,6 +1242,7 @@
   State state_;             // Protected by state_mutex_
