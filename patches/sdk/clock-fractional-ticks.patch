+// Fractional guest ticks (numerator units of guest_tick_ratio_.second) carried
+// between UpdateGuestClock calls. Converting each host delta separately and
+// discarding the remainder lost up to one guest tick per call; with high-rate
+// mftb polling on Apple Silicon (24 MHz host, ratio 25/12) the guest clock ran
+// ~0.96x real time. Guarded by tick_mutex_; reset when the ratio changes.
+uint64_t guest_tick_remainder_ = 0;
 
+namespace {
+// guest = (host_delta * first + remainder) / second, keeping the new remainder.
+// Split so that host_delta * first cannot overflow:
+// host_delta = q * second + r  =>  guest = q * first + (r * first + remainder) / second.
+// Requires second * (first + 1) < 2^64, true for all reduced tick ratios.
+uint64_t ConvertHostTickDelta(uint64_t host_tick_delta, std::pair<uint64_t, uint64_t> ratio,
+                              uint64_t& remainder) {
+  const uint64_t q = host_tick_delta / ratio.second;
+  const uint64_t r = host_tick_delta % ratio.second;
+  const uint64_t partial = r * ratio.first + remainder;
+  remainder = partial % ratio.second;
+  return q * ratio.first + partial / ratio.second;
+}
+}  // namespace
