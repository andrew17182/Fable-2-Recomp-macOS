+// Fable II recomp (patches/sdk/vfs-skip-dev-dirs.patch): when the game data root is the
+// development checkout, the startup scan walked its build output, git objects and SDK
+// sources (~177k of ~179k entries, 0.5-1 s at every boot, growing with out/). The
+// game opens nothing there by enumeration; those top-level directories keep their entry
+// but are not walked. An open below them resolves through ResolvePath's lazy host
+// lookup, which now walks each directory it adds (skip intro opens
+// game:\out\skipintro\*.bik). FABLE2_VFS_SKIP_DEV_DIRS=0 walks everything again.
+static bool SkipDevDirChildren(const HostPathEntry* parent, const HostPathEntry* root,
+                               const std::filesystem::path& name) {
+  static const bool on = [] {
+    const char* v = std::getenv("FABLE2_VFS_SKIP_DEV_DIRS");
+    return !(v && v[0] == '0');
+  }();
+  if (!on || parent != root) {
+    return false;
+  }
+  const std::string n = rex::path_to_utf8(name);
+  return n == "out" || n == ".git" || n == "thirdparty";
+}
+
 void HostPathDevice::PopulateEntry(HostPathEntry* parent_entry) {
   auto child_infos = rex::filesystem::ListFiles(parent_entry->host_path());
   for (auto& child_info : child_infos) {
@@ -121,6 +150,12 @@
     parent_entry->children_.push_back(std::unique_ptr<Entry>(child));
 
     if (child_info.type == rex::filesystem::FileInfo::Type::kDirectory) {
+      if (SkipDevDirChildren(parent_entry, static_cast<HostPathEntry*>(root_entry_.get()),
+                             child_info.name)) {
+        REXFS_INFO("[vfs-skip-dev-dirs] not walking {} (opens resolve lazily)",
+                   rex::path_to_utf8(child->host_path()));
+        continue;
+      }
       PopulateEntry(child);
     }
   }
