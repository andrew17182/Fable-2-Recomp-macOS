+// Thread-exit signal safety (patches/sdk/thread-exit-signal-safe.patch).
+// The suspend/user-callback signal handler must not touch a C++ thread_local:
+// on Darwin every thread_local (even a constant-initialised POD, and __thread)
+// lives in a dyld TLV block that is allocated with malloc on a thread's first
+// access and freed by a pthread key destructor in pthread_exit. A signal that
+// lands while the thread is inside pthread_exit's TSD cleanup (holding the
+// malloc zone lock) re-instantiates the block -> malloc -> "recursively lock an
+// os_unfair_lock" abort. The handler therefore finds its thread through a
+// pthread key (pthread_getspecific reads the TSD slot directly: no allocation),
+// and threads block these signals before they start exiting.
+static pthread_key_t signal_thread_key_;
+static pthread_once_t signal_thread_key_once_ = PTHREAD_ONCE_INIT;
+static void create_signal_thread_key() {
+  if (pthread_key_create(&signal_thread_key_, nullptr) != 0) {
+    assert_always();
+  }
+}
+static void ensure_signal_thread_key() {
+  pthread_once(&signal_thread_key_once_, create_signal_thread_key);
+}
+
+// Blocks the runtime's thread signals on the calling thread for the rest of its
+// life and forgets the thread's signal target. Called before a thread publishes
+// that it has finished and before pthread_exit / returning from the start
+// routine; signals sent after this stay pending and die with the thread.
+static void block_thread_signals_for_exit() {
+  sigset_t set;
+  sigemptyset(&set);
+  sigaddset(&set, GetSystemSignal(SignalType::kThreadSuspend));
+  sigaddset(&set, GetSystemSignal(SignalType::kThreadUserCallback));
+  pthread_sigmask(SIG_BLOCK, &set, nullptr);
+  ensure_signal_thread_key();
+  pthread_setspecific(signal_thread_key_, nullptr);
+}
