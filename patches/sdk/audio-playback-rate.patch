+/// Playback rate of the output stage (fable2 turbo, docs/turbo.md). The host
+/// consumes guest audio `rate` times faster than real time, so the guest audio
+/// clock keeps pace with a sped-up guest clock, and squeezes it back into real
+/// time on macOS with an Apple audio unit:
+///   kNaturalPitch - AUNewTimePitch time-stretch (faster, same pitch);
+///   kHighPitch    - AUVarispeed resampling (faster and higher, like tape);
+///   kNormal       - no processing; the guest is paced at 1x (original path).
+/// rate <= 1 or kNormal bypasses the units: the output path is the original
+/// one, bit for bit. Safe to call from any thread; the device callback picks
+/// the new value up on its next call, with a short fade across the switch.
+#define REX_AUDIO_PLAYBACK_RATE 1
+enum class PlaybackRateMode { kNormal = 0, kNaturalPitch = 1, kHighPitch = 2 };
+void SetPlaybackRate(float rate, PlaybackRateMode mode);
+float GetPlaybackRate();
+PlaybackRateMode GetPlaybackRateMode();
+
 }  // namespace rex::audio
