+/**
+ * @file        audio/sdl/rate_unit.h
+ * @brief       Output-stage playback-rate unit (fable2 turbo): Apple AUNewTimePitch
+ *              or AUVarispeed rendered offline inside the SDL device callback.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace rex::audio::sdl {
+
+// Pulls `frames` interleaved frames into `out`; returns how many it could
+// supply (the unit zero-fills the rest).
+using RatePullFn = uint32_t (*)(void* ctx, float* out, uint32_t frames);
+
+class RateUnit {
+ public:
+  enum class Kind { kTimePitch = 1, kVarispeed = 2 };
+
+  virtual ~RateUnit() = default;
+  // nullptr (and *error set) when the platform has no such unit.
+  static std::unique_ptr<RateUnit> Create(Kind kind, uint32_t channels, uint32_t sample_rate,
+                                          uint32_t max_frames, RatePullFn pull, void* ctx,
+                                          std::string* error);
+
+  virtual bool SetRate(float rate) = 0;
+  // Renders `frames` (<= max_frames) interleaved frames into `out`.
+  virtual bool Render(float* out, uint32_t frames) = 0;
+  // Drops the unit's internal history (next render starts clean).
+  virtual void Reset() = 0;
+  virtual double LatencySeconds() const = 0;
+  virtual const char* Name() const = 0;
+};
+
+}  // namespace rex::audio::sdl
