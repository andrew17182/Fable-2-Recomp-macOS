+/**
+ * @file        audio/sdl/rate_unit_apple.cpp
+ * @brief       RateUnit on Apple audio units, rendered offline (no AUGraph, no
+ *              device): the SDL device callback calls AudioUnitRender, and the
+ *              unit pulls its input through a render callback from the guest
+ *              frame queue. Kept apart from the rex headers on purpose, so the
+ *              AudioToolbox names never meet them.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#include "rate_unit.h"
+
+#if defined(__APPLE__)
+
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+#include <vector>
+
+namespace rex::audio::sdl {
+namespace {
+
+class AppleRateUnit final : public RateUnit {
+ public:
+  AppleRateUnit(Kind kind, uint32_t channels, uint32_t max_frames, RatePullFn pull, void* ctx)
+      : kind_(kind), channels_(channels), max_frames_(max_frames), pull_(pull), ctx_(ctx) {}
+
+  ~AppleRateUnit() override {
+    if (unit_) {
+      AudioUnitUninitialize(unit_);
+      AudioComponentInstanceDispose(unit_);
+    }
+  }
+
+  bool Init(uint32_t sample_rate, std::string* error) {
+    AudioComponentDescription desc = {};
+    desc.componentType = kAudioUnitType_FormatConverter;
+    desc.componentSubType =
+        kind_ == Kind::kTimePitch ? kAudioUnitSubType_NewTimePitch : kAudioUnitSubType_Varispeed;
+    desc.componentManufacturer = kAudioUnitManufacturer_Apple;
+    AudioComponent component = AudioComponentFindNext(nullptr, &desc);
+    if (!component) return Fail(error, "audio unit not found", 0);
+    OSStatus st = AudioComponentInstanceNew(component, &unit_);
+    if (st != noErr) return Fail(error, "AudioComponentInstanceNew", st);
+
+    // Non-interleaved float32, the units' canonical format, at the device rate.
+    AudioStreamBasicDescription fmt = {};
+    fmt.mSampleRate = sample_rate;
+    fmt.mFormatID = kAudioFormatLinearPCM;
+    fmt.mFormatFlags = AudioFormatFlags(kAudioFormatFlagsNativeFloatPacked) |
+                      AudioFormatFlags(kAudioFormatFlagIsNonInterleaved);
+    fmt.mBytesPerPacket = sizeof(float);
+    fmt.mFramesPerPacket = 1;
+    fmt.mBytesPerFrame = sizeof(float);
+    fmt.mChannelsPerFrame = channels_;
+    fmt.mBitsPerChannel = 32;
+    for (AudioUnitScope scope : {kAudioUnitScope_Input, kAudioUnitScope_Output}) {
+      st = AudioUnitSetProperty(unit_, kAudioUnitProperty_StreamFormat, scope, 0, &fmt,
+                                sizeof(fmt));
+      if (st != noErr) return Fail(error, "StreamFormat", st);
+    }
+    UInt32 max_slice = max_frames_;
+    st = AudioUnitSetProperty(unit_, kAudioUnitProperty_MaximumFramesPerSlice,
+                              kAudioUnitScope_Global, 0, &max_slice, sizeof(max_slice));
+    if (st != noErr) return Fail(error, "MaximumFramesPerSlice", st);
+    AURenderCallbackStruct cb = {&AppleRateUnit::Input, this};
+    st = AudioUnitSetProperty(unit_, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input,
+                              0, &cb, sizeof(cb));
+    if (st != noErr) return Fail(error, "SetRenderCallback", st);
+    st = AudioUnitInitialize(unit_);
+    if (st != noErr) return Fail(error, "AudioUnitInitialize", st);
+
+    list_storage_.resize(offsetof(AudioBufferList, mBuffers) + sizeof(AudioBuffer) * channels_);
+    planar_.assign(size_t(channels_) * max_frames_, 0.0f);
+    pull_buffer_.assign(size_t(channels_) * kPullChunk, 0.0f);
+    return true;
+  }
+
+  bool SetRate(float rate) override {
+    const AudioUnitParameterID param =
+        kind_ == Kind::kTimePitch ? AudioUnitParameterID(kNewTimePitchParam_Rate)
+                                  : AudioUnitParameterID(kVarispeedParam_PlaybackRate);
+    return AudioUnitSetParameter(unit_, param, kAudioUnitScope_Global, 0, rate, 0) == noErr;
+  }
+
+  bool Render(float* out, uint32_t frames) override {
+    if (frames > max_frames_) return false;
+    auto* list = reinterpret_cast<AudioBufferList*>(list_storage_.data());
+    list->mNumberBuffers = channels_;
+    for (uint32_t c = 0; c < channels_; ++c) {
+      list->mBuffers[c].mNumberChannels = 1;
+      list->mBuffers[c].mDataByteSize = frames * sizeof(float);
+      list->mBuffers[c].mData = planar_.data() + size_t(c) * max_frames_;
+    }
+    AudioUnitRenderActionFlags flags = 0;
+    AudioTimeStamp ts = {};
+    ts.mFlags = kAudioTimeStampSampleTimeValid;
+    ts.mSampleTime = sample_time_;
+    const OSStatus st = AudioUnitRender(unit_, &flags, &ts, 0, frames, list);
+    sample_time_ += frames;
+    if (st != noErr) {
+      std::memset(out, 0, sizeof(float) * frames * channels_);
+      return false;
+    }
+    // The unit may hand back its own buffers; read through the list.
+    for (uint32_t c = 0; c < channels_; ++c) {
+      const float* src = static_cast<const float*>(list->mBuffers[c].mData);
+      for (uint32_t i = 0; i < frames; ++i) out[size_t(i) * channels_ + c] = src[i];
+    }
+    return true;
+  }
+
+  void Reset() override {
+    AudioUnitReset(unit_, kAudioUnitScope_Global, 0);
+    sample_time_ = 0;
+  }
+
+  double LatencySeconds() const override {
+    Float64 latency = 0;
+    UInt32 size = sizeof(latency);
+    AudioUnitGetProperty(unit_, kAudioUnitProperty_Latency, kAudioUnitScope_Global, 0, &latency,
+                         &size);
+    return latency;
+  }
+
+  const char* Name() const override {
+    return kind_ == Kind::kTimePitch ? "AUNewTimePitch" : "AUVarispeed";
+  }
+
+ private:
+  static constexpr uint32_t kPullChunk = 512;
+
+  static bool Fail(std::string* error, const char* what, OSStatus st) {
+    if (error) *error = std::string(what) + " failed (OSStatus " + std::to_string(st) + ")";
+    return false;
+  }
+
+  // Input render callback: interleaved frames from the guest queue, split into
+  // the unit's per-channel buffers.
+  static OSStatus Input(void* ref, AudioUnitRenderActionFlags*, const AudioTimeStamp*, UInt32,
+                        UInt32 frames, AudioBufferList* io) {
+    auto* self = static_cast<AppleRateUnit*>(ref);
+    const uint32_t ch = self->channels_;
+    uint32_t done = 0;
+    while (done < frames) {
+      const uint32_t want = std::min<uint32_t>(frames - done, kPullChunk);
+      const uint32_t got = self->pull_(self->ctx_, self->pull_buffer_.data(), want);
+      for (uint32_t c = 0; c < ch && c < io->mNumberBuffers; ++c) {
+        float* dst = static_cast<float*>(io->mBuffers[c].mData) + done;
+        for (uint32_t i = 0; i < got; ++i) dst[i] = self->pull_buffer_[size_t(i) * ch + c];
+        for (uint32_t i = got; i < want; ++i) dst[i] = 0.0f;
+      }
+      done += want;
+    }
+    return noErr;
+  }
+
+  Kind kind_;
+  uint32_t channels_;
+  uint32_t max_frames_;
+  RatePullFn pull_;
+  void* ctx_;
+  AudioUnit unit_ = nullptr;
+  Float64 sample_time_ = 0;
+  std::vector<uint8_t> list_storage_;
+  std::vector<float> planar_;
+  std::vector<float> pull_buffer_;
+};
+
+}  // namespace
+
+std::unique_ptr<RateUnit> RateUnit::Create(Kind kind, uint32_t channels, uint32_t sample_rate,
+                                           uint32_t max_frames, RatePullFn pull, void* ctx,
+                                           std::string* error) {
+  auto unit = std::make_unique<AppleRateUnit>(kind, channels, max_frames, pull, ctx);
+  if (!unit->Init(sample_rate, error)) return nullptr;
+  return unit;
+}
+
+}  // namespace rex::audio::sdl
+
+#else
+
+namespace rex::audio::sdl {
+std::unique_ptr<RateUnit> RateUnit::Create(Kind, uint32_t, uint32_t, uint32_t, RatePullFn, void*,
+                                           std::string* error) {
+  if (error) *error = "no playback-rate unit on this platform";
+  return nullptr;
+}
+}  // namespace rex::audio::sdl
+
+#endif
