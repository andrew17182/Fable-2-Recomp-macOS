+constexpr uint32_t kMaxCredits = 64;    // AudioSystem::kMaximumQueuedFrames
+
+// Linear ramp over one chunk (5.3 ms): up = fade in, else fade out.
+void Ramp(float* data, uint32_t frames, uint32_t channels, bool up) {
+  for (uint32_t i = 0; i < frames; ++i) {
+    const float t = (float(i) + 0.5f) / float(frames);
+    const float g = up ? t : 1.0f - t;
+    for (uint32_t c = 0; c < channels; ++c) data[size_t(i) * channels + c] *= g;
+  }
+}
+
+// Minimal float WAV writer for audio_capture (diagnostics only).
+struct WavCapture {
+  std::FILE* file = nullptr;
+  uint32_t channels = 0;
+  uint64_t frames = 0;
+  void Open(const std::string& path, uint32_t ch) {
+    file = std::fopen(path.c_str(), "wb");
+    channels = ch;
+    if (file) WriteHeader();
+  }
+  void WriteHeader() {
+    auto u32 = [this](uint32_t v) { std::fwrite(&v, 4, 1, file); };
+    auto u16 = [this](uint16_t v) { std::fwrite(&v, 2, 1, file); };
+    const uint32_t bytes = uint32_t(std::min<uint64_t>(frames * channels * 4, 0xFFFFFF00u));
+    std::fseek(file, 0, SEEK_SET);
+    std::fwrite("RIFF", 1, 4, file); u32(36 + bytes);
+    std::fwrite("WAVEfmt ", 1, 8, file); u32(16); u16(3); u16(uint16_t(channels));
+    u32(48000); u32(48000 * channels * 4); u16(uint16_t(channels * 4)); u16(32);
+    std::fwrite("data", 1, 4, file); u32(bytes);
+    std::fseek(file, 0, SEEK_END);
+  }
+  void Write(const float* data, uint32_t n) {
+    if (!file) return;
+    std::fwrite(data, sizeof(float) * channels, n, file);
+    frames += n;
+  }
+  void Close() {
+    if (!file) return;
+    WriteHeader();
+    std::fclose(file);
+    file = nullptr;
+  }
+};
+}  // namespace
