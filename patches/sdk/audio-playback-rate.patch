+    //   rate x output pulls up to 8% faster. The error is held within +-100 ms so it
+    //   cannot wind up while the next trim holds the rate down.
+    // - starvation: when the guest's audio worker cannot keep up (CPU contention at 3-4x),
+    //   a queue below a quarter of the credit slows the pull by up to 20% instead of
+    //   feeding the unit silence (a gap). Time-stretch keeps the pitch; varispeed drops it.
+    constexpr double kMaxBehind = 0.1 * 48000.0;
+    double behind = double(rs.rate) * double(rs.ctl_out) - double(rs.ctl_in) - rs.ctl_bias;
+    if (behind > kMaxBehind || behind < -kMaxBehind) {
+      const double held = std::clamp(behind, -kMaxBehind, kMaxBehind);
+      rs.ctl_bias += behind - held;
+      behind = held;
     }
+    rs.drift_ms = behind / 48.0;
+    rs.fill += 0.05 * (double(rs.last_queue) / std::max(1, rs.credit_target) - rs.fill);
+    const double slow = rs.fill < 0.25 ? (0.25 - rs.fill) * 0.8 : 0.0;
+    const double trim = std::clamp(behind / 48000.0 * 1.0, -0.08, 0.08) - slow;
+    rs.min_trim = std::min(rs.min_trim, trim);
+    const float target = rs.rate * float(1.0 + trim);
+    if (std::fabs(target - rs.applied_rate) > 0.0005f * rs.rate) {
+      rs.unit->SetRate(target);
+      rs.applied_rate = target;
+    }
   }
+
+  while (additional_amount > 0) {
+    if (rs.active) unit_chunk(); else direct_chunk();
+    const bool fade = rs.fade_in;
+    rs.fade_in = false;
+    if (!put(fade, true)) break;
+    additional_amount -= len;
+  }
   SDL_stack_free(data);
+
+  // audio_rate_stats: queue depth and consumption against real time.
+  const int32_t stats_s = REXCVAR_GET(audio_rate_stats);
+  if (stats_s > 0) {
+    const auto now = std::chrono::steady_clock::now();
+    const double dt = std::chrono::duration<double>(now - rs.stats_t0).count();
+    if (dt >= stats_s) {
+      const uint64_t submitted = driver->submitted_frames_.load(std::memory_order_relaxed);
+      const double sub_rate = double(submitted - rs.stats_submitted0) * 256.0 / 48000.0 / dt;
+      size_t queued;
+      {
+        std::unique_lock<std::mutex> guard(driver->frames_mutex_);
+        queued = driver->frames_queued_.size();
+      }
+      REXAPU_INFO(
+          "[audio-rate] stats {:.1f}s: path {} rate {:.2f} | guest produced {:.3f}x real, "
+          "consumed {:.3f}x, output {:.3f}x | queue now {} min {} avg {:.1f} max {} frames "
+          "(credit {}, debt {}) | starved {} frames, silent chunks {} | drift {:.1f} ms, unit rate {:.3f} (lowest {:.3f}), pulled/out {:.3f}",
+          dt, rs.active ? rs.unit->Name() : "direct", rs.active ? rs.rate : 1.0f, sub_rate,
+          rs.in_frames / 48000.0 / dt, rs.out_frames / 48000.0 / dt, queued,
+          rs.queue_samples ? rs.queue_min : 0, rs.queue_samples ? double(rs.queue_sum) / rs.queue_samples : 0.0,
+          rs.queue_max, rs.credit_target, rs.credit_debt, rs.starved_frames, rs.silent_chunks,
+          rs.active ? rs.drift_ms : 0.0, rs.active ? rs.applied_rate : 1.0f,
+          rs.active ? rs.rate * (1.0 + rs.min_trim) : 1.0,
+          rs.active && rs.ctl_out > rs.win_out0
+              ? double(rs.ctl_in - rs.win_in0) / double(rs.ctl_out - rs.win_out0) : 1.0);
+      rs.min_trim = 0.0;
+      rs.win_in0 = rs.ctl_in;
+      rs.win_out0 = rs.ctl_out;
+      if (capturing) {
+        rs.capture.WriteHeader();
+        std::fflush(rs.capture.file);
+      }
+      rs.stats_t0 = now;
+      rs.stats_submitted0 = submitted;
+      rs.in_frames = rs.out_frames = rs.starved_frames = rs.silent_chunks = 0;
+      rs.queue_min = SIZE_MAX;
+      rs.queue_max = rs.queue_sum = rs.queue_samples = 0;
+    }
+  }
 }
 
+namespace {
+uint32_t PullGuestFrames(void* ctx, float* out, uint32_t frames) {
+  return SDLAudioDriver::PullForRateUnit(static_cast<SDLAudioDriver*>(ctx), out, frames);
+}
+}  // namespace
+
+uint32_t SDLAudioDriver::PullForRateUnit(SDLAudioDriver* driver, float* out, uint32_t frames) {
+  RateStage& rs = *driver->rate_;
+  const uint32_t ch = rs.channels;
+  uint32_t done = 0;
+  while (done < frames) {
+    if (rs.carry_pos == rs.carry_len) {
+      std::unique_lock<std::mutex> guard(driver->frames_mutex_);
+      if (driver->frames_queued_.empty()) break;
+      auto buffer = driver->frames_queued_.front();
+      driver->frames_queued_.pop();
+      switch (ch) {
+        case 2:
+          conversion::sequential_6_BE_to_interleaved_2_LE(rs.carry.data(), buffer,
+                                                          channel_samples_, rs.fold, rs.gain);
+          break;
+        case 6:
+          conversion::sequential_6_BE_to_interleaved_6_LE(rs.carry.data(), buffer,
+                                                          channel_samples_, rs.mix, rs.gain);
+          break;
+        default:
+          std::fill(rs.carry.begin(), rs.carry.end(), 0.0f);
+          break;
+      }
+      driver->frames_unused_.push(buffer);
+      driver->ReturnCredit();
+      rs.carry_pos = 0;
+      rs.carry_len = channel_samples_;
+      rs.in_frames += channel_samples_;
+    }
+    const uint32_t n = std::min(frames - done, rs.carry_len - rs.carry_pos);
+    std::memcpy(out + size_t(done) * ch, rs.carry.data() + size_t(rs.carry_pos) * ch,
+                sizeof(float) * n * ch);
+    rs.carry_pos += n;
+    done += n;
+  }
+  rs.starved_frames += frames - done;
+  rs.ctl_in += frames;
+  return done;
+}
+
