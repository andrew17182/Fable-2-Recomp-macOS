+  rate_->credit_base = std::clamp<int>(REXCVAR_GET(audio_maxqframes), 4, int(kMaxCredits));
+  rate_->credit_target = rate_->credit_base;
+  rate_->capture_path = REXCVAR_GET(audio_capture);
+}
 
