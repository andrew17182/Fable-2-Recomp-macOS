+// Turbo audio (rex::audio::SetPlaybackRate, docs/turbo.md in fable2). At rate r
+// the device callback consumes guest frames r times faster than real time and
+// squeezes them into real time with an Apple unit (AUNewTimePitch keeps the
+// pitch, AUVarispeed resamples), so the guest audio clock keeps pace with the
+// sped-up guest clock instead of lagging at 1x. The guest's credit (frames it
+// may have queued, AudioSystem's client semaphore) grows to base x r x
+// audio_rate_headroom (default 2, capped at 64): the guest's audio worker
+// competes with a game running r times faster, and the extra buffered real
+// time absorbs its short stalls (at 4x with headroom 1 it starved ~1% of input). When
+// the rate drops back, the extra credit becomes debt: consumed frames repay it
+// instead of releasing, and the frames queued beyond the base are dropped
+// under the fade, so no turbo backlog plays at 1x. At rate 1 (or kNormal) the
+// stage is idle: the callback runs the original direct path.
+struct SDLAudioDriver::RateStage {
+  std::unique_ptr<RateUnit> unit;
+  PlaybackRateMode unit_mode = PlaybackRateMode::kNormal;
+  bool unit_failed[3] = {};
+  bool active = false;  // rendering through the unit
+  float rate = 1.0f;
+  bool fade_in = false;
+  uint32_t channels = 2;
+
+  int credit_base = 8;
+  int credit_target = 8;
+  int credit_debt = 0;
+
+  // One converted guest frame, interleaved in the device layout.
+  std::vector<float> carry;
+  uint32_t carry_pos = 0;
+  uint32_t carry_len = 0;
+  StereoFold fold;
+  SurroundMix mix;
+  float gain = 1.0f;
+
+  // Stats (audio_rate_stats).
+  std::chrono::steady_clock::time_point stats_t0 = std::chrono::steady_clock::now();
+  uint64_t stats_submitted0 = 0;
+  uint64_t in_frames = 0, out_frames = 0, starved_frames = 0, silent_chunks = 0;
+  // Rate control (see the trim block in SDLCallback). ctl_in/ctl_out: input the unit pulled
+  // (starved frames included) and output it rendered since switch-on; fill: smoothed queue
+  // fill as a fraction of the credit.
+  uint64_t ctl_in = 0, ctl_out = 0;
+  float applied_rate = 1.0f;
+  double drift_ms = 0.0;
+  double fill = 1.0;
+  size_t last_queue = 0;
+  double min_trim = 0.0;  // lowest trim this stats window
+  uint64_t win_in0 = 0, win_out0 = 0;
+  double ctl_bias = 0.0;  // error discarded by the +-100 ms hold (frames)
+  size_t queue_min = SIZE_MAX, queue_max = 0, queue_sum = 0, queue_samples = 0;
+  std::string capture_path;
+  WavCapture capture;
+  bool capture_opened = false;
+};
+
+void SDLAudioDriver::ReturnCredit() {
+  // frames_mutex_ held by the caller.
+  if (rate_ && rate_->credit_debt > 0) {
+    --rate_->credit_debt;
+    return;
+  }
+  auto ret = semaphore_->Release(1, nullptr);
+  assert_true(ret);
+}
+
