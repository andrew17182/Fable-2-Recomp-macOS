+// Win32 waits take whole milliseconds: round a microsecond timeout up (0 still polls).
+static std::chrono::milliseconds CeilMillis(std::chrono::microseconds timeout) {
+  return std::chrono::ceil<std::chrono::milliseconds>(timeout);
