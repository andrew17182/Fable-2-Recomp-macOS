+
+bool Clock::fine_guest_durations() {
+  static const bool on = [] {
+    const char* v = std::getenv("FABLE2_TURBO_FINE_DELAY");
+    return !(v && v[0] == '0' && v[1] == 0);
+  }();
+  return on && guest_time_scalar_ != 1.0 && !REXCVAR_GET(clock_no_scaling);
+}
+
+uint64_t Clock::ScaleGuestDurationMillisToMicros(uint32_t guest_ms) {
+  constexpr uint32_t max = std::numeric_limits<uint32_t>::max();
+  if (!guest_ms) {
+    return 0;
+  } else if (guest_ms == max || REXCVAR_GET(clock_no_scaling)) {
+    return uint64_t(guest_ms) * 1000;
+  }
+  const uint64_t scaled_us = static_cast<uint64_t>(double(guest_ms) * 1000.0 / guest_time_scalar_);
+  return std::max<uint64_t>(1, scaled_us);
 }
 
