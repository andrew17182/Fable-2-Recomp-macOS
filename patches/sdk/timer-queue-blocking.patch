  private:
+#if defined(__APPLE__)
+  static constexpr uintptr_t kWakeIdent = 1;
+  static constexpr uintptr_t kTimerIdent = 2;
+  int kq_ = -1;
+  std::atomic<bool> sleeping_{false};
+
+  // Same contract as claim_strategy_.wait_until_published(seq, seq - 1, until): returns
+  // the last published sequence, or seq - 1 when nothing new arrived before `until`.
+  dp::sequence_t WaitBlocking(dp::sequence_t next_sequence, clock::time_point until) {
+    for (;;) {
+      // Non-blocking check (a time point in the past returns after the short spin phase).
+      dp::sequence_t available = claim_strategy_.wait_until_published(
+          next_sequence, next_sequence - 1, clock::time_point::min());
+      if (available != next_sequence - 1) {
+        return available;
+      }
+      const clock::time_point now = clock::now();
+      if (until <= now) {
+        return available;
+      }
+      sleeping_.store(true, std::memory_order_seq_cst);
+      available = claim_strategy_.wait_until_published(next_sequence, next_sequence - 1,
+                                                       clock::time_point::min());
+      if (available != next_sequence - 1) {
+        sleeping_.store(false, std::memory_order_relaxed);
+        return available;
+      }
+      struct kevent changes[1];
+      int nchanges = 0;
+      if (until != clock::time_point::max()) {
+        const auto us = std::chrono::duration_cast<std::chrono::microseconds>(until - now).count();
+        EV_SET(&changes[0], kTimerIdent, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+               NOTE_USECONDS | NOTE_CRITICAL, std::max<int64_t>(1, us), nullptr);
+        nchanges = 1;
+      } else {
+        // No due timer: drop a timer still armed from an earlier wait (ignore ENOENT).
+        EV_SET(&changes[0], kTimerIdent, EVFILT_TIMER, EV_DELETE, 0, 0, nullptr);
+        kevent(kq_, changes, 1, nullptr, 0, nullptr);
+      }
+      struct kevent out[2];
+      kevent(kq_, changes, nchanges, out, 2, nullptr);
+      sleeping_.store(false, std::memory_order_relaxed);
+    }
+  }
+#endif
+
   // This ring buffer will be used to introduce timers queued by the public API
   static constexpr size_t kWaitCount = 512;
   dp::ring_buffer<std::shared_ptr<WaitItem>> buffer_;
