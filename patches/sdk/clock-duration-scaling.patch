-          std::chrono::floor<WClock_::duration>(delta / rex::chrono::Clock::guest_time_scalar());
+          std::chrono::floor<WClock_::duration>(delta * rex::chrono::Clock::guest_time_scalar());
     }
     return x_now + delta;
   }
