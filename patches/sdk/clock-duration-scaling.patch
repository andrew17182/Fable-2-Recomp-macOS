+++ b/include/rex/chrono/chrono.h
@@ -143,8 +143,9 @@
 
     auto delta = (t - x_now);
     if (!REXCVAR_GET(clock_no_scaling)) {
+      // Guest time runs guest_time_scalar() times faster than host time.
       delta =
-          std::chrono::floor<WClock_::duration>(delta * rex::chrono::Clock::guest_time_scalar());
+          std::chrono::floor<WClock_::duration>(delta / rex::chrono::Clock::guest_time_scalar());
     }
     return w_now + delta;
   }
@@ -167,7 +168,7 @@
     rex::chrono::hundrednanoseconds delta = (t - w_now);
