 void FunctionGraph::notifyFunctionAdded(FunctionNode* newFunction) {
-  for (auto& [base, node] : functions_) {
-    if (node.get() != newFunction && node->isPending()) {
+  // Only a function with an unresolved jump to newFunction's base can resolve anything here, and
+  // every unresolved jump is added through addUnresolvedJumpToFunction, which indexes it. Each
+  // function's resolution only touches that function, so the visiting order does not matter and
+  // the result is the same as trying every PENDING function. A base listed twice, or whose jump
+  // was resolved meanwhile, finds nothing to resolve.
+  auto indexed = unresolvedTargetIndex_.find(newFunction->base());
+  if (indexed == unresolvedTargetIndex_.end())
+    return;
+  for (uint32_t base : indexed->second) {
+    auto it = functions_.find(base);
+    if (it == functions_.end())
+      continue;
+    FunctionNode* node = it->second.get();
+    if (node != newFunction && node->isPending()) {
       node->tryResolveAgainst(newFunction);
     }
   }
