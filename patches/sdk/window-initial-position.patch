+// Whether a window placed at (x, y) (client-area origin) keeps a usable part of
+// its title bar on a connected display: a saved position may refer to a display
+// that is gone. Wide arithmetic, since x / y may come from a file. On success
+// `usable_out` (optional) receives that display's usable bounds.
+bool IsTitleBarOnDisplay(SDL_Window* window, int32_t x, int32_t y, SDL_Rect* usable_out = nullptr) {
+  int top = 0;
+  SDL_GetWindowBordersSize(window, &top, nullptr, nullptr, nullptr);
+  int count = 0;
+  SDL_DisplayID* displays = SDL_GetDisplays(&count);
+  bool visible = false;
+  for (int i = 0; i < count && !visible; ++i) {
+    SDL_Rect bounds;
+    if (!SDL_GetDisplayUsableBounds(displays[i], &bounds)) {
+      continue;
+    }
+    const int64_t left = x;
+    const int64_t title_top = int64_t(y) - top;
+    visible = left >= int64_t(bounds.x) - 64 && left + 64 <= int64_t(bounds.x) + bounds.w &&
+              title_top >= bounds.y && title_top + 32 <= int64_t(bounds.y) + bounds.h;
+    if (visible && usable_out) {
+      *usable_out = bounds;
+    }
+  }
+  SDL_free(displays);
+  return visible;
+}
+
+// Smallest initial client size an app-provided size is raised to (window coordinates).
+constexpr int32_t kMinInitialWidth = 640;
+constexpr int32_t kMinInitialHeight = 360;
+
+// Clamps an app-provided client size to [minimum, usable area of `usable`],
+// leaving room for the title bar. A display smaller than the minimum wins.
+void ClampInitialSize(SDL_Window* window, const SDL_Rect& usable, int32_t& width,
+                      int32_t& height) {
+  int top = 0;
+  SDL_GetWindowBordersSize(window, &top, nullptr, nullptr, nullptr);
+  const int32_t max_width = std::max(1, usable.w);
+  const int32_t max_height = std::max(1, usable.h - top);
+  width = std::clamp(width, std::min(kMinInitialWidth, max_width), max_width);
+  height = std::clamp(height, std::min(kMinInitialHeight, max_height), max_height);
+}
+
