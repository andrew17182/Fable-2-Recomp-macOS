+RenderTargetCache::RenderTargetKey RenderTargetCache::GetTileOwner(
+    uint32_t tile) const {
+  auto it = ownership_ranges_.upper_bound(tile);
+  if (it == ownership_ranges_.begin()) {
+    return RenderTargetKey();
+  }
+  --it;
+  if (it->second.end_tiles <= tile) {
+    return RenderTargetKey();
+  }
+  return it->second.render_target;
+}
