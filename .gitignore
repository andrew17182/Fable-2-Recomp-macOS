.DS_Store
/scratch/

# --- Manifest backup (pre-rename safety copy) --------------------------------
fable_2_manifest.toml.bak

# --- Loose helper scripts & images at the repo root (kept out of the repo) -----
# Scripts under tools/, tests/ and backends/ are tracked normally (until 2026-10-13 every *.py / *.sh was ignored
# and whitelisted one by one, which left new tests untracked; the 2026-10-13 release audit).
/*.ps1
/*.py
/*.sh
*.png
build_*.log
rebuild.log
rebuild2.log
__pycache__/

# --- Fetched/external toolchain deps (created by tools/setup_sdk*.cmd). -------
# The tracked files in thirdparty/ (rexglue-sdk-local.patch,
# rexglue-sdk-submodule-pins.txt, vulkan/, vk_video/) stay in the repo.
thirdparty/rexglue-sdk-src/
thirdparty/android-ndk/

